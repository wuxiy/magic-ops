# MagicOps 部署凭据模板（切片 32）。复制为 .env 并填写真实值：cp .env.example .env
# .env 已在 .gitignore 中，严禁将真实密码提交到仓库。

# PostgreSQL 数据库密码（postgres/console/runtime 共用）
DB_PASSWORD=change-me-db-password

# Console 管理员初始密码（prod profile 下仅创建 admin 账号，不提供则不初始化用户）
MAGICOPS_ADMIN_PASSWORD=change-me-admin-password

# 签名密钥对（prod fail-fast，缺失时 Console/Runtime 启动失败）。
# 生成方式（JDK 21）：
#   mvn -q -pl magicops-sign compile exec:java \
#     -Dexec.mainClass=top.cywu.magicops.sign.key.KeyPairGeneratorUtil 2>/dev/null
# 或直接运行编译后的 KeyPairGeneratorUtil，将输出的 export 语句值填入此处。
MAGICOPS_PRIVATE_KEY=change-me-base64-pkcs8-private-key
MAGICOPS_PUBLIC_KEY=change-me-base64-x509-public-key
# 可选：密钥标识（默认 magicops-default）。使用 KeyStore 时改为 MAGICOPS_KEYSTORE_PATH/PASSWORD/TYPE
MAGICOPS_KEY_ID=magicops-default

# Console 推送发布包到 Runtime 的共享密钥（两侧必须一致；prod 下 Runtime 缺失时收包 fail-closed）
MAGICOPS_RUNTIME_SHARED_SECRET=change-me-push-secret

# Runtime 查询/修复 API 的 Basic 认证凭据
RUNTIME_USERNAME=runtime
RUNTIME_PASSWORD=change-me-runtime-password
