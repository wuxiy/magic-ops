<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>top.cywu</groupId>
    <artifactId>magicops-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MagicOps</name>
    <description>MagicOps - 医卫/政务内网动态开发与运维平台</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <magicops.version>0.1.0-SNAPSHOT</magicops.version>
    </properties>

    <modules>
        <module>magicops-core</module>
        <module>magicops-governance</module>
        <module>magicops-audit</module>
        <module>magicops-sign</module>
        <module>magicops-sql-guard</module>
        <module>magicops-http</module>
        <module>magicops-crypto</module>
        <module>magicops-console</module>
        <module>magicops-runtime</module>
        <module>magicops-diagnosis</module>
        <module>magicops-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MagicOps internal modules -->
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-core</artifactId>
                <version>${magicops.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-governance</artifactId>
                <version>${magicops.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-audit</artifactId>
                <version>${magicops.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-sign</artifactId>
                <version>${magicops.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-sql-guard</artifactId>
                <version>${magicops.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-http</artifactId>
                <version>${magicops.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-crypto</artifactId>
                <version>${magicops.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cywu</groupId>
                <artifactId>magicops-diagnosis</artifactId>
                <version>${magicops.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Shared test dependencies for all modules -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
