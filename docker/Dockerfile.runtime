FROM eclipse-temurin:21-jre-alpine
LABEL maintainer="MagicOps <dev@cywu.top>"

WORKDIR /app

COPY magicops-runtime/target/magicops-runtime-0.1.0-SNAPSHOT.jar app.jar

ENV JAVA_OPTS="-Xms256m -Xmx512m"
ENV SPRING_PROFILES_ACTIVE=prod

EXPOSE 8081

# 健康检查：收包状态查询端点（permitAll GET）。
HEALTHCHECK --interval=5s --timeout=5s --start-period=30s --retries=12 \
  CMD wget -q --spider http://127.0.0.1:8081/api/packages/active || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
